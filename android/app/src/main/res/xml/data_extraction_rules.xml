<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing is backed up or transferred: the device token only works with this device's keystore
    key, a device identity must not be cloned onto another phone, and the synced data is fetched
    again from the daemon after pairing.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
